{
  "name": "@aigility-harness/appbase",
  "version": "0.1.0",
  "private": true,
  "description": "AppBase 产品装配：多功能对话厅 + Codex 网页应用开发员 + AI 网关",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aigility-harness/core": "workspace:*",
    "@aigility-harness/dsh-interop": "workspace:*",
    "@aigility-harness/layer-cognitive": "workspace:*",
    "@aigility-harness/layer-infrastructure": "workspace:*",
    "@aigility-harness/layer-orchestration": "workspace:*",
    "@aigility-harness/layer-action": "workspace:*",
    "@aigility-harness/layer-persona": "workspace:*",
    "@deepseek-ai/cordis": "~4.0.4",
    "@timem/dsh-plugin-timem": "git+https://git.aigility.cloud/TiMEM-AI/dsh-plugin-timem.git#e8a96cee3df5d62070e9c94d87a18e16b565dc55",
    "pg": "^8.23.0",
    "prototype-mode": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./backend": {
      "types": "./src/backend.ts",
      "default": "./src/backend.ts"
    },
    "./dsh-host": {
      "types": "./src/dsh-host.ts",
      "default": "./src/dsh-host.ts"
    },
    "./llm-node-store": {
      "types": "./src/llm-node-store.ts",
      "default": "./src/llm-node-store.ts"
    }
  }
}
