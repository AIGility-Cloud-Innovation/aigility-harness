@echo off
setlocal
chcp 65001 >nul
rem ============================================================
rem  AppBase one-click start (TEMPLATE).
rem  Copy to start-appbase.cmd (git-ignored, safe for secrets),
rem  then fill every [FILL: ...] value below.
rem
rem  NOTE: keep this file ASCII-only with CRLF line endings.
rem  A .cmd saved as UTF-8 with Chinese comments breaks cmd.exe:
rem  it decodes lines with the OEM codepage (GBK on zh-CN systems)
rem  and `chcp 65001` mid-file re-syncs byte offsets, so every line
rem  after the switch turns into garbage commands.
rem ============================================================

rem ---- PostgreSQL (Docker container appbase-pg, host port 5433,
rem ---- aligned with the default PG port in code) ----
set "APPBASE_PG_PASSWORD=[FILL: container POSTGRES_PASSWORD]"
rem First run on a new machine: container missing -> auto-create it
rem (named volume appbase_pg_data keeps data persistent across restarts)
docker start appbase-pg 2>nul
if errorlevel 1 (
  docker run -d --name appbase-pg --restart unless-stopped ^
    -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=%APPBASE_PG_PASSWORD% ^
    -e POSTGRES_DB=appbase -p 127.0.0.1:5433:5432 ^
    -v appbase_pg_data:/var/lib/postgresql/data postgres:16-alpine
)

rem ---- LLM upstream (required; without any key the pages load but
rem ---- chat/AI replies "app LLM not configured". The admin UI
rem ---- "LLM config" page persists to PG and always wins over env) ----
set "BIGMODEL_API_KEY=[FILL: zhipu BigModel API key]"

rem ---- coding agent driver: zcode / codex (default codex) ----
set "APPBASE_RELAY_TARGETS=look_log=http://[FILL: log service host:port]/look_log"
set "AGENT_DRIVER=zcode"
rem optional, usually not needed (defaults: node + zcode.cjs under Program Files):
rem set "ZCODE_NODE_BIN=D:\Program Files\nodejs\node.exe"
rem set "ZCODE_CLI_PATH=C:\Program Files\ZCode\resources\glm\zcode.cjs"

rem ---- fixed AI gateway key (if unset, a random key is generated and
rem ---- printed to console at every start; external callers must follow)
set "APPBASE_GATEWAY_KEY=[FILL: long random string, e.g. openssl rand -hex 24]"

rem ---- login token signing: persisted in src\.token-secret by default,
rem ---- survives restarts, no need to set.
rem set "APPBASE_TOKEN_SECRET="

rem ---- admin accounts (optional): comma-separated email whitelist,
rem ---- UNIONed with the is_admin column in DB. When neither is set,
rem ---- the first registered user becomes admin. SQL promotion:
rem      UPDATE users SET is_admin=true WHERE email='...'
rem set "APPBASE_ADMIN_EMAILS=admin@example.com"

rem ---- registration switch (optional): set false to allow login only
rem ---- for existing accounts (default: registration open)
rem set "APPBASE_ALLOW_REGISTER=false"

rem ---- login rate limit: built in, 5 failures per IP+email locks for
rem ---- 15 minutes, no configuration needed ----

cd /d "%~dp0"
echo [start-appbase] starting AppBase via pnpm start ...
pnpm start
