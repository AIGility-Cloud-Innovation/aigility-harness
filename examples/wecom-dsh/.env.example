# ============================================================
# wecom-dsh 配置（复制为同目录 .env 并填入真实值；.env 已被 .gitignore 忽略）
#
# 用本目录的 .env 而非仓库根 .env 的原因：
# 官方 dsh 的 readEnvLayer 禁止工作区方向的 .env 文件出现保留变量名
# （DSH_BIN / DSH_HOME / DEEPSEEK_BASE_URL 等，只允许环境变量注入），
# 而 dsh 子进程的工作目录是仓库根。本目录在 dsh 的加载范围之外，
# 因此可以直接使用 dsh 的原生变量名，无需任何别名转换。
# ============================================================

# 企微「智能机器人」凭证（企微管理后台 → 智能机器人 → 创建）
WECOM_DSH_BOT_ID=在此填入你的企微机器人 botId
WECOM_DSH_BOT_SECRET=在此填入你的企微机器人 secret

# 官方 dsh CLI 入口（lib/bin.js 绝对路径）
# 查找：node -e "console.log(require.resolve('@deepseek-ai/dsh/package.json'))"
# bin.js 在所得路径同目录的 lib\bin.js
DSH_BIN=D:\SiteWorkspace\aigility-harness\node_modules\.pnpm\@deepseek-ai+dsh@0.1.5-rc.2_<hash>\node_modules\@deepseek-ai\dsh\lib\bin.js

# DSH 家目录（sessions/profiles 所在；与 Web GUI 共用即可互通会话历史）
DSH_HOME=D:\SiteWorkspace\aigility-harness\examples\.dsh-home

# headless 上游（OpenAI 兼容；直连或指向网关）
DEEPSEEK_API_KEY=xxx
DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 可选
# DSH_CWD=D:\SiteWorkspace\aigility-harness   # agent 工作区（默认本仓库根）
# DSH_PERMISSION_MODE=read-only
