{
  "name": "@aigility-harness/workflow-studio",
  "version": "0.1.0",
  "description": "工作流可视化编排 Studio（React 组件）—— 编排域(D4)的设计面工具。文档引擎（保守 YAML 写回）在 @aigility-harness/layer-orchestration/workflow-doc；画布交互移植自 gyzy_platform（自由拖拽 + 贝塞尔连线 + 节点库拖入）并补齐连线增删与旁路语义。",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aigility-harness/layer-orchestration": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "lucide-react": ">=0.400"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "@types/react": "^19.0.0",
    "lucide-react": "^0.562.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
