{
  "name": "@aigility-harness/py-bridge",
  "version": "0.1.0",
  "description": "通用 Python 对接器：声明式配置接入任意 Python 包（JSON-RPC over stdio，零端口），只依赖 core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aigility-harness/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./py": {
      "types": "./src/py-bridge.ts",
      "default": "./src/py-bridge.ts"
    }
  }
}
