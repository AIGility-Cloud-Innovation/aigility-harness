{
  "name": "prototype-mode",
  "version": "0.1.0",
  "description": "原型模式示例：内存版 KernelAdapter + 五层插件组装",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./in-memory-kernel": {
      "types": "./src/in-memory-kernel.ts",
      "default": "./src/in-memory-kernel.ts"
    }
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aigility-harness/core": "workspace:*",
    "@aigility-harness/layer-infrastructure": "workspace:*",
    "@aigility-harness/layer-cognitive": "workspace:*",
    "@aigility-harness/layer-orchestration": "workspace:*",
    "@aigility-harness/layer-action": "workspace:*",
    "@aigility-harness/layer-persona": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.0"
  }
}
