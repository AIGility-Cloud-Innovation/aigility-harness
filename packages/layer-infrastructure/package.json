{
  "name": "@aigility-harness/layer-infrastructure",
  "version": "0.1.0",
  "description": "底座基础层：日志 + 配置 + 协议适配 + HTTP 入口 + 跨语言桥接（bridge）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aigility-harness/core": "workspace:*",
    "@aigility-harness/layer-cognitive": "workspace:*",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bridge": {
      "types": "./bridge/src/index.ts",
      "default": "./bridge/src/index.ts"
    },
    "./bridge/py": {
      "types": "./bridge/src/py-bridge.ts",
      "default": "./bridge/src/py-bridge.ts"
    }
  }
}