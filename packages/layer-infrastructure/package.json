{
  "name": "@aigility-harness/layer-infrastructure",
  "version": "0.1.0",
  "description": "底座基础层（L1）：日志 + 配置 + 协议适配 + HTTP/企微入口 + 消息总线",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
