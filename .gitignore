# 例外: log-monitor.html 日志监控看板入库 (部署相关地址一律用占位符/空默认, 真实值在本地 daemon-config)
examples/apps/*
!examples/apps/teacher-notebook.html
!examples/apps/log-monitor.html
__pycache__/
*.pyc
examples/appbase/src/.token-secret
# AppBase 本机一键启动脚本 (含密钥, 不入库); 模板: start-appbase.cmd.example
examples/appbase/start-appbase.cmd

# ZCode CLI 在仓库内运行时的产物
.zcode/
examples/timem-live-test/

# dsh headless agent home (profiles/sessions/credentials cache, 可重建但体积大)
examples/.dsh-home/

# DSH web UI one-click start script (contains key, not committed); template: start-dsh-web.cmd.example
examples/appbase/start-dsh-web.cmd

# local workspace helpers (not committed)
.workbuddy/
*.bak
examples/wecom-dsh/.state/
