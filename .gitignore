# 运行时缓存/索引 (可重建, 不入库)
examples/wecom-timem/kb_index/
# AppBase: codex 生成器产物目录 (运行时可重建, 不入库)
# 例外: teacher-notebook.html 作为示例应用保留入库
# 例外: log-monitor 前后端入库; 独立 schtasks 自启方案已退役 (后端 daemon 由 AppBase
# 进程宿主统一纳管, 大厅抽屉启停, 见 examples/appbase/src/process-host.ts)
# 真实 config/state 等运行时文件仍被 examples/apps/* 挡住
examples/apps/*
!examples/apps/teacher-notebook.html
!examples/apps/log-monitor.html
!examples/apps/log-monitor-daemon.js
!examples/apps/log-monitor-daemon-config.example.json
__pycache__/
*.pyc
examples/appbase/src/.token-secret
# AppBase 本机一键启动脚本 (含密钥, 不入库); 模板: start-appbase.cmd.example
examples/appbase/start-appbase.cmd
examples/appbase/start-appbase.sh

# ZCode CLI 在仓库内运行时的产物
.zcode/
examples/timem-live-test/

# dsh headless agent home (profiles/sessions/credentials cache, 可重建但体积大)
examples/.dsh-home/

# DSH web UI one-click start script (contains key, not committed); template: start-dsh-web.cmd.example
examples/appbase/start-dsh-web.cmd
examples/appbase/start-dsh-web.sh

# local workspace helpers (not committed)
.workbuddy/
*.bak
examples/wecom-dsh/.state/
# FDE workbench one-click start script (contains key, not committed); template: start-fde-workbench.cmd.example
examples/fde-workbench/start-fde-workbench.cmd
# fde-workbench local test artifacts
examples/fde-workbench/.tmp/

# feishu 本地凭证仓（整个目录不入库；首次授权引导脚本在 packages/layer-action/authorize-feishu.ts）
feishu/
